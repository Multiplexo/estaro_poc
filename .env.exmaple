# Local development infrastructure. Replace password placeholders before use.
POSTGRES_HOST=localhost
CELERY_BROKER_URL=redis://localhost:6379/0
REDIS_PORT=6379
POSTGRES_PORT=5432
POSTGRES_DB=estaro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=estaro-admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=inquiries
MINIO_SECURE=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# OpenAI-compatible AI provider. Leave LLM_BASE_URL empty for OpenAI itself.
# Langdock (EU): https://api.langdock.com/openai/eu/v1
# Check a provider with: uv --directory backend run python -m scripts.check_llm_provider
LLM_BASE_URL=
API_KEY=...
MODEL=...
RECURSION_LIMIT=50
LLM_MAX_RETRIES=4

# PDF conversion (see docs/pdf-konvertierung.md for measurements)
PDF_NUM_THREADS=4
PDF_IMAGES_SCALE=2.0
PDF_OCR_ENABLED=true

MS_CLIENT_ID=your-application-client-id
MS_CLIENT_SECRET=your-client-secret-value
MS_AUTHORITY=https://login.microsoftonline.com/consumers
MS_REDIRECT_URI=http://localhost:8000/auth/callback
MS_FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://127.0.0.1:5173"]
MS_FETCH_ENABLED=false
# Shared mailbox read with application permission (see docs/postfach.md)
MS_MAILBOX=
MS_FETCH_INTERVAL_SECONDS=300

# Sign-in with Microsoft Entra ID (see docs/anmeldung.md). Required in production.
AUTH_ENABLED=false
AUTH_TENANT_ID=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# At least 32 random characters, e.g. from: openssl rand -base64 48
SESSION_SECRET=

# Nightly master data sync from Sage (see docs/stammdaten.md); empty disables it
MASTERDATA_SOURCE=
MASTERDATA_CSV_DIR=/data/stammdaten
MASTERDATA_SQL_URL=
MASTERDATA_SYNC_HOUR_UTC=2

# Sage import file layout (see docs/sage-export.md); empty uses the built-in placeholder
SAGE_EXPORT_MAPPING=

# Feedback is stored in the app; optionally posted as JSON to a ticket system webhook
FEEDBACK_WEBHOOK_URL=
